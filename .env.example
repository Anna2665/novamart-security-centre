# ---- NovaMart configuration (copy to .env) ------------------------------------------------------------
# Database: SQLite works out of the box. For PostgreSQL (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://cyberguard:cyberguard@localhost:5432/cyberguard
DATABASE_URL=sqlite:///./data/cyberguard.db

# Staff (Security Centre) sign-ins send their 6-digit code HERE by real email.
# Customers who register in the shop receive their codes at the email address they sign up with.
DEMO_EMAIL=annamariya2605@gmail.com

# ---- SMTP (required for real email OTP) --------------------------------------------------------------------
# Gmail: Google Account > Security > 2-Step Verification ON > App passwords > create one for "Mail".
# Use that 16-character app password below (NOT your normal Google password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=your.sender@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=NovaMart <your.sender@gmail.com>
BRAND_NAME=NovaMart

# ---- Demo accounts: admin / analyst / viewer (Security Centre) and shopper (a sample customer). Leave empty to auto-generate strong passwords, shown once in data/demo_credentials.txt) --
CG_ADMIN_PASSWORD=
CG_ANALYST_PASSWORD=
CG_VIEWER_PASSWORD=
CG_SHOPPER_PASSWORD=

# ---- Secrets (leave empty: generated once into data/secrets.json with mode 0600) --------------------------
CG_MASTER_KEY=
JWT_SECRET=
OTP_PEPPER=

# ---- OTP policy --------------------------------------------------------------------------------------------
OTP_TTL_SECONDS=60
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=15
# Development ONLY, when SMTP is not configured: show the code in the UI behind a loud banner. Never use in a real demo.
OTP_DEV_ECHO=false

TELEMETRY_ENABLED=true

# ---- E-mail over HTTPS (Resend) - for hosted servers that block SMTP (free Render/Railway) -----------------
# Create a free account at resend.com with the SAME address as DEMO_EMAIL, make an API key, paste it here.
# With the default sender, Resend delivers only to that account address. When set, it is used instead of SMTP.
RESEND_API_KEY=
RESEND_FROM=NovaMart <onboarding@resend.dev>
